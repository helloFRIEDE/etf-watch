# 複製這個檔案成 .env，再填入你自己的值。.env 已被 .gitignore 排除，不會上傳到 GitHub。
# 兩種擇一：有填 AZURE_OPENAI_ENDPOINT 就用 Azure，否則用 OpenAI 官方。

# ---- 方案 A：Azure OpenAI ----
# 在 Azure 入口網站 → 你的 Azure OpenAI 資源 →「金鑰與端點」可找到前兩個
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# 部署名稱：Azure AI Foundry →「部署」頁面上你取的名字（不一定等於模型名稱）
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- 方案 B：OpenAI 官方 ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# 持股資料庫位置（預設 data/portfolio.db）
ETFWATCH_DB=data/portfolio.db
